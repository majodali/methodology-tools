{
  "name": "@majodali/methodology-tools",
  "version": "0.1.0",
  "private": true,
  "description": "mtool: discharges the majodali methodology's deterministic audit duties. The methodology documents are the spec (Constitution Article 3).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test.ts",
    "mtool": "tsx src/cli.ts",
    "check": "node node_modules/project-orchestrator-service/dist/model/cli.js check",
    "render": "node node_modules/project-orchestrator-service/dist/model/cli.js render --write"
  },
  "devDependencies": {
    "@types/node": "^22",
    "project-orchestrator-service": "github:majodali/project-orchestrator-service#24639d8296e3dd44826e5d5119b8c1cb3cea4150",
    "tsx": "^4",
    "typescript": "^5"
  }
}
